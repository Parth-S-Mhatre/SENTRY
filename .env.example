# --- Tapo Camera (fill in YOUR values in .env — never commit real secrets) ---
# Preferred: components (password is URL-encoded automatically, @ -> %40).
TAPO_USERNAME=
TAPO_PASSWORD=
TAPO_IP=192.168.1.4
TAPO_RTSP_PORT=554
TAPO_STREAM=stream2

# Optional full-URL override (only if you need a non-standard path).
# If set, it takes precedence over the components above.
TAPO_RTSP_URL=

# Legacy alias for TAPO_IP (either works).
TAPO_CAMERA_IP=

CAMERA_NAME=Entrance Camera
CAMERA_ID=camera_01

# --- Stream / pipeline tuning (low-bandwidth defaults) ---
STREAM_WIDTH=640
STREAM_FPS=10
RTSP_TIMEOUT_SECONDS=10

# --- Detection pipeline (always-on worker) ---
SUSPICIOUS_DURATION_SECONDS=30
PIPELINE_ENABLED=1
PIPELINE_SAMPLE_FPS=2.0
SAVE_PERSON_DETECTED=1
PERSON_COOLDOWN_SEC=60

# --- NVIDIA NIM (OPTIONAL — core pipeline must work without this) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=

# --- Supabase (backend only, later stage; frontend never gets secrets) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

ADMIN_USERNAME=admin
